generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ─── Domain Models ──────────────────────────────────────────────────────────

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  username       String?       @unique
  hashedPassword String
  fullName       String
  avatarUrl      String?
  emailVerified  Boolean       @default(false)
  accountStatus  AccountStatus @default(ACTIVE)

  profile    Profile?
  preference UserPreference?
  sessions   Session[]

  // Workspace Relations
  bookmarks  Bookmark[]
  smartNotes SmartNote[]
  flashcards Flashcard[]

  // Progress & Adaptive
  learningDNA    LearningDNA?
  conceptMastery ConceptMastery[]
  studySessions  StudySession[]

  // Observability
  activities Activity[]

  // New Models
  chatSessions  ChatSession[]
  studyPlans    StudyPlan[]
  practiceSets  PracticeSet[]
  userBadges    UserBadge[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model Profile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  bio         String?   @db.Text
  dateOfBirth DateTime? @db.Date
  country     String?
  state       String?
  city        String?
  timezone    String    @default("UTC")
  streak      Int       @default(0)
  points      Int       @default(0)
  xp          Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model UserPreference {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @unique @db.Uuid
  preferredLanguageId  String  @db.Uuid
  theme                Theme   @default(SYSTEM)
  notificationsEnabled Boolean @default(true)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [preferredLanguageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([preferredLanguageId])
  @@map("user_preferences")
}

model Language {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  code       String  @unique
  nativeName String
  active     Boolean @default(true)

  preferences UserPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("languages")
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  hashedRefreshToken String
  expiresAt          DateTime
  revokedAt          DateTime?

  deviceName      String?
  browser         String?
  operatingSystem String?
  ipAddress       String?
  userAgent       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// ─── Lesson Content Models ──────────────────────────────────────────────────

model Subject {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String? @db.Text

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

model Lesson {
  id          String  @id @default(uuid()) @db.Uuid
  subjectId   String  @db.Uuid
  slug        String
  title       String
  description String? @db.Text
  difficulty  String  @default("intermediate")
  order       Int     @default(0)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  // Workspace scoping
  bookmarks  Bookmark[]
  smartNotes SmartNote[]
  flashcards Flashcard[]
  activities Activity[]

  // New Models
  chatSessions ChatSession[]
  planTasks    PlanTask[]
  practiceSets PracticeSet[]

  // Mastery scoping
  conceptMastery ConceptMastery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, slug])
  @@map("lessons")
}

model Topic {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  title    String
  order    Int    @default(0)

  lesson   Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("topics")
}

model Section {
  id      String @id @default(uuid()) @db.Uuid
  topicId String @db.Uuid
  title   String
  content String @db.Text
  type    String @default("text")
  order   Int    @default(0)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sections")
}

// ─── Workspace Models (Lesson-Scoped) ───────────────────────────────────────

model Bookmark {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  lessonId  String  @db.Uuid
  sectionId String?
  type      String  @default("concept")
  content   String  @db.Text
  note      String? @db.Text

  isPinned   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  folder     String?
  tags       String[]
  color      String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, lessonId])
  @@map("bookmarks")
}

model SmartNote {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  lessonId String   @db.Uuid
  title    String?
  text     String   @db.Text
  summary  String?  @db.Text
  tags     String[]

  folder       String?
  isDraft      Boolean @default(false)
  isPinned     Boolean @default(false)
  versionCount Int     @default(1)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, lessonId])
  @@map("smart_notes")
}

model Flashcard {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @db.Uuid
  lessonId         String  @db.Uuid
  front            String  @db.Text
  back             String  @db.Text
  sourceNoteId     String? @db.Uuid
  sourceBookmarkId String? @db.Uuid

  status       String    @default("new")
  nextReviewAt DateTime?

  deck        String?
  tags        String[]
  easeFactor  Float    @default(2.5)
  interval    Int      @default(0)
  repetitions Int      @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, lessonId])
  @@map("flashcards")
}

// ─── Progress & Adaptive Models ─────────────────────────────────────────────

model LearningDNA {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  visualPreference Float @default(0.5)
  pacePreference   Float @default(0.5)
  detailPreference Float @default(0.5)

  audioPreference     Float @default(0.5)
  readingPreference   Float @default(0.5)
  animationPreference Float @default(0.5)
  examplePreference   Float @default(0.5)
  analogyPreference   Float @default(0.5)

  learningSpeed     Float @default(1.0)
  readingSpeed      Float @default(1.0)
  attentionSpan     Float @default(15.0)
  quizAccuracy      Float @default(0.0)
  revisionFrequency Float @default(1.0)

  averageSessionDuration Float @default(0.0)
  averageConfidence      Float @default(0.0)
  averageAttempts        Float @default(0.0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learning_dna")
}

model ConceptMastery {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  lessonId  String @db.Uuid
  conceptId String

  confidence    Float @default(0.0)
  struggleCount Int   @default(0)

  forgettingCurve Float     @default(1.0)
  trend           String    @default("STABLE")
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId, conceptId])
  @@map("concept_mastery")
}

model StudySession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  startTime DateTime  @default(now())
  endTime   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("study_sessions")
}

// ─── Observability (Lesson-Scoped) ──────────────────────────────────────────

model Activity {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  lessonId String? @db.Uuid
  type     String
  details  Json?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, lessonId, type])
  @@map("activities")
}

// ─── AI Mentor Models ───────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  lessonId  String?  @db.Uuid
  title     String?
  status    String   @default("active")
  
  messages  ChatMessage[]
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_sessions")
}

model ChatMessage {
  id            String      @id @default(uuid()) @db.Uuid
  chatSessionId String      @db.Uuid
  role          String      // "user" or "assistant"
  content       String      @db.Text
  contextText   String?     @db.Text
  
  session       ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())

  @@map("chat_messages")
}

// ─── Study Plans ────────────────────────────────────────────────────────────

model StudyPlan {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  type        String   @default("weekly") // daily, weekly, adaptive
  startDate   DateTime
  endDate     DateTime
  progress    Float    @default(0)
  
  tasks       PlanTask[]
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("study_plans")
}

model PlanTask {
  id          String    @id @default(uuid()) @db.Uuid
  planId      String    @db.Uuid
  lessonId    String?   @db.Uuid
  title       String
  status      String    @default("pending") // pending, completed
  completedAt DateTime?
  
  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("plan_tasks")
}

// ─── Practice & Assessments ─────────────────────────────────────────────────

model PracticeSet {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  lessonId    String?   @db.Uuid
  type        String    @default("practice") // practice, mock_test
  difficulty  String    @default("mixed")
  status      String    @default("in_progress") // in_progress, completed
  score       Float?
  
  questions   Question[]
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("practice_sets")
}

model Question {
  id            String      @id @default(uuid()) @db.Uuid
  practiceSetId String      @db.Uuid
  text          String      @db.Text
  options       Json
  correctAnswer String
  explanation   String?     @db.Text
  hint          String?     @db.Text
  
  userAnswer    String?
  isCorrect     Boolean?
  timeSpentMs   Int?
  
  practiceSet   PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)

  @@map("questions")
}

// ─── Achievements ───────────────────────────────────────────────────────────

model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String   @db.Text
  icon        String
  xpReward    Int      @default(0)
  
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  badgeId   String   @db.Uuid
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}
