generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ─── Domain Models ──────────────────────────────────────────────────────────

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  username       String?       @unique
  hashedPassword String
  fullName       String
  avatarUrl      String?
  emailVerified  Boolean       @default(false)
  accountStatus  AccountStatus @default(ACTIVE)

  // Identity & Auth Extensions
  accountType                    String    @default("STUDENT") // "STUDENT" | "PARENT"
  countryCode                    String?
  mobileNumber                   String?
  termsAccepted                  Boolean   @default(false)
  termsAcceptedAt                DateTime?
  privacyAcceptedAt              DateTime?
  parentResponsibilitiesAcceptedAt DateTime?

  // Onboarding & Profile Completion
  onboardingCompleted Boolean @default(false)
  onboardingStep      String? // Tracks progress e.g., "PERSONAL_DETAILS", "ACADEMIC_DETAILS"
  profileCompletion   Int     @default(0) // Percentage 0-100

  profile    Profile?
  preference UserPreference?
  sessions   Session[]

  // Workspace Relations
  bookmarks  Bookmark[]
  smartNotes SmartNote[]
  flashcards Flashcard[]

  // Progress & Adaptive
  learningDNA    LearningDNA?
  conceptMastery ConceptMastery[]
  studySessions  StudySession[]

  // Observability
  activities Activity[]

  // New Models
  chatSessions  ChatSession[]
  studyPlans    StudyPlan[]
  practiceSets  PracticeSet[]
  userBadges    UserBadge[]
  userSubjects  UserSubject[]

  knowledgeCollections KnowledgeCollection[]
  educationalArtifacts EducationalArtifact[]
  interactions         LearningInteraction[]
  recommendations      Recommendation[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model Profile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  bio         String?   @db.Text
  dateOfBirth DateTime? @db.Date
  country     String?
  state       String?
  city        String?
  timezone    String    @default("UTC")
  streak      Int       @default(0)
  points      Int       @default(0)
  xp          Int       @default(0)

  // Student Specific
  gender           String?
  board            String?
  medium           String?
  gradeClass       String?
  stream           String?
  schoolName       String?
  preferredLanguage String?

  // Parent Specific
  parentName       String?
  relationship     String?
  phone            String?
  alternatePhone   String?
  occupation       String?

  // Optional Details
  alternateEmail   String?
  emergencyContact String?
  socialLinks      Json?
  learningInterests String[]
  careerGoal       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model UserPreference {
  id                   String  @id @default(uuid()) @db.Uuid
  userId               String  @unique @db.Uuid
  preferredLanguageId  String? @db.Uuid
  theme                Theme   @default(SYSTEM)
  accentColor          String  @default("#6C5CE7")
  notificationsEnabled Boolean @default(true)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language? @relation(fields: [preferredLanguageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([preferredLanguageId])
  @@map("user_preferences")
}

model Language {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  code       String  @unique
  nativeName String
  active     Boolean @default(true)

  preferences UserPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("languages")
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  hashedRefreshToken String
  expiresAt          DateTime
  revokedAt          DateTime?

  deviceName      String?
  browser         String?
  operatingSystem String?
  ipAddress       String?
  userAgent       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// ─── Lesson Content Models ──────────────────────────────────────────────────

model Subject {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String? @db.Text

  lessons Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

model UserSubject {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("user_subjects")
}

model Lesson {
  id          String  @id @default(uuid()) @db.Uuid
  subjectId   String  @db.Uuid
  slug        String
  title       String
  description String? @db.Text
  difficulty  String  @default("intermediate")
  order       Int     @default(0)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  // Workspace scoping
  bookmarks  Bookmark[]
  smartNotes SmartNote[]
  flashcards Flashcard[]
  activities Activity[]

  // New Models
  chatSessions ChatSession[]
  planTasks    PlanTask[]
  practiceSets PracticeSet[]

  // Mastery scoping
  conceptMastery ConceptMastery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, slug])
  @@map("lessons")
}

model Topic {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  title    String
  order    Int    @default(0)

  lesson   Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("topics")
}

model Section {
  id      String @id @default(uuid()) @db.Uuid
  topicId String @db.Uuid
  title   String
  content String @db.Text
  type    String @default("text")
  order   Int    @default(0)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sections")
}

// ─── Workspace Models (Lesson-Scoped) ───────────────────────────────────────

model Bookmark {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  lessonId  String  @db.Uuid
  sectionId String?
  type      String  @default("concept")
  content   String  @db.Text
  note      String? @db.Text

  isPinned   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  folder     String?
  tags       String[]
  color      String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, lessonId])
  @@map("bookmarks")
}

model SmartNote {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  lessonId String   @db.Uuid
  title    String?
  text     String   @db.Text
  summary  String?  @db.Text
  tags     String[]

  folder       String?
  isDraft      Boolean @default(false)
  isPinned     Boolean @default(false)
  versionCount Int     @default(1)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, lessonId])
  @@map("smart_notes")
}

model Flashcard {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @db.Uuid
  lessonId         String  @db.Uuid
  front            String  @db.Text
  back             String  @db.Text
  sourceNoteId     String? @db.Uuid
  sourceBookmarkId String? @db.Uuid

  status       String    @default("new")
  nextReviewAt DateTime?

  deck        String?
  tags        String[]
  easeFactor  Float    @default(2.5)
  interval    Int      @default(0)
  repetitions Int      @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, lessonId])
  @@map("flashcards")
}

// ─── Progress & Adaptive Models ─────────────────────────────────────────────

model LearningDNA {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  visualPreference Float @default(0.5)
  pacePreference   Float @default(0.5)
  detailPreference Float @default(0.5)

  audioPreference     Float @default(0.5)
  readingPreference   Float @default(0.5)
  animationPreference Float @default(0.5)
  examplePreference   Float @default(0.5)
  analogyPreference   Float @default(0.5)

  learningSpeed     Float @default(1.0)
  readingSpeed      Float @default(1.0)
  attentionSpan     Float @default(15.0)
  quizAccuracy      Float @default(0.0)
  revisionFrequency Float @default(1.0)

  averageSessionDuration Float @default(0.0)
  averageConfidence      Float @default(0.0)
  averageAttempts        Float @default(0.0)

  // New Adaptive Fields
  velocity               Float @default(1.0)
  consistency            Float @default(1.0)
  streak                 Int   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learning_dna")
}

model ConceptMastery {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  lessonId  String @db.Uuid
  conceptId String

  confidence       Float @default(0.0)
  struggleCount    Int   @default(0)
  
  // New Adaptive Fields
  retention        Float @default(1.0)
  difficulty       Float @default(0.5)
  revisionPriority Float @default(0.0)
  weakTopicStatus  Boolean @default(false)
  reviewHistory    Json? // Array of { date, confidence, wasCorrect }

  forgettingCurve  Float     @default(1.0)
  trend            String    @default("STABLE")
  lastReviewedAt   DateTime?
  nextReviewAt     DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId, conceptId])
  @@map("concept_mastery")
}

model StudySession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  startTime DateTime  @default(now())
  endTime   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("study_sessions")
}

// ─── Observability (Lesson-Scoped) ──────────────────────────────────────────

model Activity {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @db.Uuid
  lessonId String? @db.Uuid
  type     String
  details  Json?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, lessonId, type])
  @@map("activities")
}

// ─── AI Mentor Models ───────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  lessonId  String?  @db.Uuid
  title     String?
  status    String   @default("active") // active, archived, deleted
  isPinned  Boolean  @default(false)
  metadata  Json?
  
  messages  ChatMessage[]
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_sessions")
}

model ChatMessage {
  id            String      @id @default(uuid()) @db.Uuid
  chatSessionId String      @db.Uuid
  role          String      // "user" or "assistant" or "system"
  content       String      @db.Text
  contextText   String?     @db.Text
  
  tokensUsed    Int?
  durationMs    Int?
  metadata      Json?
  version       Int         @default(1)
  
  session       ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())

  @@map("chat_messages")
}

// ─── Study Plans ────────────────────────────────────────────────────────────

model StudyPlan {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  type        String   @default("weekly") // daily, weekly, adaptive
  startDate   DateTime
  endDate     DateTime
  progress    Float    @default(0)
  
  tasks       PlanTask[]
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("study_plans")
}

model PlanTask {
  id          String    @id @default(uuid()) @db.Uuid
  planId      String    @db.Uuid
  lessonId    String?   @db.Uuid
  title       String
  status      String    @default("pending") // pending, completed
  completedAt DateTime?
  
  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("plan_tasks")
}

// ─── Practice & Assessments ─────────────────────────────────────────────────

model PracticeSet {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  lessonId    String?   @db.Uuid
  type        String    @default("practice") // practice, mock_test
  difficulty  String    @default("mixed")
  status      String    @default("in_progress") // in_progress, completed
  score       Float?
  
  questions   Question[]
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("practice_sets")
}

model Question {
  id            String      @id @default(uuid()) @db.Uuid
  practiceSetId String      @db.Uuid
  text          String      @db.Text
  options       Json
  correctAnswer String
  explanation   String?     @db.Text
  hint          String?     @db.Text
  
  userAnswer    String?
  isCorrect     Boolean?
  timeSpentMs   Int?
  
  practiceSet   PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)

  @@map("questions")
}

// ─── Achievements ───────────────────────────────────────────────────────────

model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String   @db.Text
  icon        String
  xpReward    Int      @default(0)
  
  userBadges  UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  badgeId   String   @db.Uuid
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─────────────────────────────────────────────────────────────────────────────
// Knowledge Domain & Retrieval Augmented Generation (RAG) Infrastructure
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeCollection {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  
  ownerId     String   @db.Uuid
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  documents   KnowledgeDocument[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("knowledge_collections")
}

model KnowledgeDocument {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @db.Uuid
  title        String
  sourceType   String   // pdf, web, text, video
  sourceUri    String?  @db.Text
  status       String   @default("pending") // pending, processing, indexed, failed
  
  metadata     Json?
  permissions  Json?    // AC rules, role-based visibility
  tags         String[]
  
  collection   KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("knowledge_documents")
}

model DocumentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @db.Uuid
  versionHash String   // To track changes/deduplication
  byteSize    Int?
  
  chunks      DocumentChunk[]
  
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@map("document_versions")
}

model DocumentChunk {
  id           String   @id @default(uuid()) @db.Uuid
  versionId    String   @db.Uuid
  content      String   @db.Text
  chunkType    String   // Concept, Definition, Formula, Example, Exercise, Paragraph
  
  embedding    Unsupported("vector(768)")?
  
  metadata     Json?
  
  tokenCount   Int?
  
  version      DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@map("document_chunks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Educational Artifacts & Study Tools Engine
// ─────────────────────────────────────────────────────────────────────────────

model EducationalArtifact {
  id                  String   @id @default(uuid()) @db.Uuid
  artifactType        String   // FLASHCARD, QUIZ, SMART_NOTES, REVISION_SHEET, etc.
  title               String
  description         String?  @db.Text
  
  content             Json     // Structured content based on artifact type
  
  sourceConversationId String? @db.Uuid
  sourceKnowledgeIds  String[] // Array of document or chunk IDs
  
  version             Int      @default(1)
  language            String   @default("en")
  tags                String[]
  educationalMetadata Json?    // Difficulty, Weak Concept links, Revision Priority
  
  ownerId             String   @db.Uuid
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("educational_artifacts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Adaptive Learning & Mastery Engine
// ─────────────────────────────────────────────────────────────────────────────

model LearningInteraction {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  actionType      String   // FLASHCARD_VIEWED, FLASHCARD_ANSWERED, QUIZ_STARTED, etc.
  targetId        String?  @db.Uuid
  targetType      String?  // EducationalArtifact, Lesson, etc.
  
  isCorrect       Boolean?
  timeSpentMs     Int?
  confidenceScore Float?
  
  metadata        Json?
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@map("learning_interactions")
}

model Recommendation {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  title           String
  description     String   @db.Text
  actionType      String   // e.g., REVIEW_CHAPTER, PRACTICE_WEAK_CONCEPT
  targetId        String?  @db.Uuid
  
  priority        Float    @default(0)
  reasoning       String?  @db.Text
  status          String   @default("PENDING") // PENDING, ACCEPTED, DISMISSED
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("recommendations")
}
